# Multpel Analytics — template de variáveis de ambiente
# Copie este arquivo pra `.env` (local) ou cadastre cada variável no Portainer (prod).
# NUNCA commitar o `.env` com valores reais.

# ── Flask ──
# OBRIGATÓRIA com FLASK_ENV=production: sem ela o app NÃO SOBE (antes ele subia com uma chave
# pública e os cookies de sessão ficavam forjáveis). Valor fixo e longo — trocar desloga todos.
SECRET_KEY=troque-essa-chave-em-prod-use-secrets.token_hex(32)
FLASK_ENV=development

# ── Módulos contratados por este cliente ──
# Define o que ESTA instância serve. Uma instância por empresa.
#   comercial,compras → os dois (caso Multpel)
#   compras           → só o Estoque (rotas do Comercial devolvem 404)
#   comercial         → só o Analytics (blueprint /estoque nem é registrado)
MODULOS=comercial,compras

# ── PostgreSQL ──
DB_HOST=localhost
DB_PORT=5432
DB_NAME=multpel_db
DB_USER=postgres
DB_PASSWORD=

# ── Redis ──
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Power BI (Service Principal Azure AD) ──
POWERBI_TENANT_ID=
POWERBI_CLIENT_ID=
POWERBI_CLIENT_SECRET=
POWERBI_GROUP_ID=
POWERBI_DATASET_ID=
# ── Módulo Compras (Estoque) ──
# Dataset próprio do estoque; o RCA é o mesmo do comercial (POWERBI_DATASET_ID).
POWERBI_DATASET_ID_ESTOQUE=
POWERBI_DATASET_ID_RCA=
# Logo do cliente impresso no PDF do pedido de compra (o produto é JOGA; este logo é de quem
# emite o pedido ao fornecedor). Vazio = usa o arquivo padrão embutido.
CLIENTE_LOGO=

# ── Resend (envio de emails) ──
RESEND_API_KEY=
RESEND_FROM=joga@jogasolucoes.com.br

# ── Cron de relatórios automáticos ──
# false em dev (evita spam), true em prod
CRON_HABILITADO=false

# ── Opcional: AI integrations (não usado por padrão) ──
OPENAI_API_KEY=
ASSEMBLYAI_API_KEY=
