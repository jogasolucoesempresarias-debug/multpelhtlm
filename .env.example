# Multpel Analytics — template de variáveis de ambiente
# Copie este arquivo pra `.env` (local) ou cadastre cada variável no Portainer (prod).
# NUNCA commitar o `.env` com valores reais.

# ── Flask ──
SECRET_KEY=troque-essa-chave-em-prod-use-secrets.token_hex(32)
FLASK_ENV=development

# ── PostgreSQL ──
DB_HOST=localhost
DB_PORT=5432
DB_NAME=multpel_db
DB_USER=postgres
DB_PASSWORD=

# ── Redis ──
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Power BI (Service Principal Azure AD) ──
POWERBI_TENANT_ID=
POWERBI_CLIENT_ID=
POWERBI_CLIENT_SECRET=
POWERBI_GROUP_ID=
POWERBI_DATASET_ID=

# ── Resend (envio de emails) ──
RESEND_API_KEY=
RESEND_FROM=joga@jogasolucoes.com.br

# ── Cron de relatórios automáticos ──
# false em dev (evita spam), true em prod
CRON_HABILITADO=false

# ── Opcional: AI integrations (não usado por padrão) ──
OPENAI_API_KEY=
ASSEMBLYAI_API_KEY=
